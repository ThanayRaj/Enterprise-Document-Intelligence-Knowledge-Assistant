# Groq API (https://console.groq.com/)
# Retrieval and indexing work without this key.
# Answer generation requires a valid key.
GROQ_API_KEY=

# Optional override. Default: llama-3.1-8b-instant
GROQ_MODEL=llama-3.1-8b-instant

# Optional: Hugging Face cache directory for the embedding model
# HF_HOME=.cache/huggingface
